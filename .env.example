# ─────────────────────────────────────────────────────────────
#  Klidoo — konfigurace prostředí
#  Zkopíruj do .env.local (vývoj) nebo .env (Docker na Hetzneru)
# ─────────────────────────────────────────────────────────────

# Veřejná URL aplikace (bez lomítka na konci)
# vývoj:  http://localhost:3000
# ostrá:  https://klidoo.cz
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase ────────────────────────────────────────────────
# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Service role klíč — NIKDY nesmí do prohlížeče.
# Používá se jen na serveru (pozvánky, cron, Google sync).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ── Google Calendar ─────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web)
# Authorized redirect URI: <NEXT_PUBLIC_SITE_URL>/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Telegram notifikace ─────────────────────────────────────
# Vytvoř bota přes @BotFather, zkopíruj token
TELEGRAM_BOT_TOKEN=
# Libovolný náhodný řetězec — chrání webhook proti cizím requestům
TELEGRAM_WEBHOOK_SECRET=

# ── EduPage (jen rodinná verze) ─────────────────────────────
# Vedlejší služba v Dockeru. Uvnitř sítě compose je to takhle:
EDUPAGE_SIDECAR_URL=http://edupage:8000
# Náhodný řetězec — musí být stejný tady i u služby edupage
EDUPAGE_SIDECAR_SECRET=

# ── Doména pro Caddy (jen na serveru) ───────────────────────
# Musí odpovídat NEXT_PUBLIC_SITE_URL bez https://
APP_DOMAIN=klidoo.cz

# ── Cron ────────────────────────────────────────────────────
# Náhodný tajný řetězec. Volá se jako:
#   curl -H "Authorization: Bearer $CRON_SECRET" https://.../api/cron/reminders
CRON_SECRET=

# ── Šifrování uložených tajemství ───────────────────────────
# Google refresh tokeny a hesla k EduPage. Bez něj se propojení
# neuloží — a když ho změníš, uložená propojení přestanou fungovat.
# Vygeneruj: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# ── Stripe (předplatné) ─────────────────────────────────────
# Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_live_...
# Dashboard → Product catalog → Klidoo → ceny (Price ID, ne Product ID)
STRIPE_PRICE_MESICNI=price_...
STRIPE_PRICE_ROCNI=price_...
# Dashboard → Developers → Webhooks → endpoint <NEXT_PUBLIC_SITE_URL>/api/stripe/webhook
# Události: checkout.session.completed, customer.subscription.*, invoice.paid,
# invoice.payment_failed
STRIPE_WEBHOOK_SECRET=whsec_...

# ── E-maily (SMTP) ──────────────────────────────────────────
# Pozvánky druhému rodiči a upozornění kolem předplatného.
# Funguje s libovolným poskytovatelem, který umí SMTP (Resend, Brevo, SES…).
# Doména musí mít SPF i DKIM, jinak zprávy končí ve spamu — viz README.
# Mailhosting u WEDOSu (server najdeš v administraci schránky)
# nebo odesílací relé, třeba smtp.resend.com
SMTP_HOST=
SMTP_PORT=587
# U mailhostingu je to celá adresa, u Resendu doslova „resend"
SMTP_USER=
SMTP_PASS=
# Odesílatel se skládá ze dvou hodnot — špičaté závorky by rozbily
# `source .env` v nasazovacím skriptu.
SMTP_FROM_NAME=Klidoo
SMTP_FROM_EMAIL=info@klidoo.cz
# Kam mají chodit odpovědi (nepovinné)
SMTP_REPLY_TO=info@klidoo.cz

# ── Interní přehled provozu ─────────────────────────────────
# Kdo uvidí /provoz. Víc e-mailů odděl čárkou. Prázdné = nikdo.
ADMIN_EMAILS=info@klidoo.cz
# Sůl pro anonymní otisk návštěvníka (openssl rand -hex 16).
# Mění se s ní denní hash — bez ní se použije CRON_SECRET.
PROVOZ_SUL=

# ── Marketingové měření (nepovinné) ─────────────────────────
# Načte se jen po souhlasu návštěvníka. Prázdné = skript se vůbec nespustí.
# Google Analytics 4: Správce → Datové proudy → ID měření (G-…)
NEXT_PUBLIC_GA_ID=
# Meta Pixel: Events Manager → ID pixelu (číslo)
NEXT_PUBLIC_META_PIXEL_ID=
